<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Registration Form Validation</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 20px;
    }

    p {
      margin: 14px 0;
    }

    input {
      padding: 6px 8px;
      font-size: 16px;
      width: 280px;
      box-sizing: border-box;
    }

    input[type="number"] {
      width: 90px;
    }

    button {
      padding: 8px 14px;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>

  <form action="submit.php" method="post">
    <p>
      <label for="fullname" class="sr-only">Full name</label>
      <input
        type="text"
        id="fullname"
        name="fullname"
        placeholder="Full name"
        required
      >
    </p>

    <p>
      <label for="email">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        placeholder="you@college.edu"
        required
      >
    </p>

    <p>
      <label for="mobile">Mobile</label>
      <input
        type="tel"
        id="mobile"
        name="mobile"
        placeholder="10-digit mobile"
        pattern="[0-9]{10}"
        maxlength="10"
        title="Enter exactly 10 digits"
        oninput="this.setCustomValidity(this.validity.patternMismatch ? 'Enter exactly 10 digits' : '')"
        required
      >
    </p>

    <p>
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Min 6 characters"
        minlength="6"
        maxlength="32"
        required
      >
    </p>

    <p>
      <label for="age">Age</label>
      <input
        type="number"
        id="age"
        name="age"
        placeholder="Age (17-30)"
        min="17"
        max="30"
        required
      >
    </p>

    <p>
      <button type="submit">Register</button>
    </p>
  </form>

</body>
</html>