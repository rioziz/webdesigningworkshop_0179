<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nested and Responsive Table</title>
  <style>
    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }

    table {
      border-collapse: collapse;
      font-family: Georgia, serif;
    }

    th, td {
      border: 1px solid #444444;
      padding: 8px 12px;
      text-align: left;
      vertical-align: middle;
    }

    th {
      text-align: center;
    }

    /* Inner nested table styling */
    table table {
      width: 100%;
    }

    table table th,
    table table td {
      padding: 6px 10px;
      text-align: left;
    }
  </style>
</head>
<body>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th scope="col">Day</th>
          <th scope="col">Lab Batches</th>
          <th scope="col">Faculty</th>
          <th scope="col">Room</th>
          <th scope="col">Time</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Friday</td>
          <td>
            <table>
              <thead>
                <tr>
                  <th scope="col">Batch</th>
                  <th scope="col">System</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>A1</td>
                  <td>PC 1-20</td>
                </tr>
                <tr>
                  <td>A2</td>
                  <td>PC 21-40</td>
                </tr>
              </tbody>
            </table>
          </td>
          <td>Dr. Sharma</td>
          <td>Lab 2</td>
          <td>2-4 PM</td>
        </tr>
      </tbody>
    </table>
  </div>

</body>
</html>