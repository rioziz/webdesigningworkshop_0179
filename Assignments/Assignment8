<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Linka Demo</title>
</head>
<body id="top">

  <p>Links demo</p>

  <!-- External Link -->
  <a href="https://www.example.com" target="_blank" rel="noopener noreferrer" title="Visit Example Website">External link</a><br>

  <!-- Internal Link (Anchor to bottom) -->
  <a href="#bottom" title="Scroll down to bottom">Jump to bottom</a><br>

  <!-- Email Link -->
  <a href="mailto:info@example.com?subject=Inquiry" title="Send us an email">Email us</a><br>

  <!-- Image Link -->
  <a href="https://www.example.com" target="_blank" title="Click logo to visit homepage">
    <img src="logo.png" alt="Logo" width="120" height="50">
  </a>

  <!-- Spacing to push the bottom section down -->
  <div style="height: 300px;"></div>

  <!-- Target section for internal link -->
  <p id="bottom">
    Bottom. <a href="#top" title="Return to the top of the page">Back to top</a>
  </p>

</body>
</html>