<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Accessible Page</title>
</head>
<body>

  <!-- Skip link -->
  <a href="#main-content">Skip to main content</a>

  <!-- Primary navigation with ARIA label -->
  <nav aria-label="Primary navigation">
    <a href="#home">Home</a>
    <a href="#help">Help</a>
  </nav>

  <!-- Main content landmark -->
  <main id="main-content">
    <h1>Accessible Page</h1>

    <!-- Accessible image with descriptive alt text -->
    <img src="banner.png" alt="College banner" width="300" height="32">
    <button type="button" aria-label="Close banner">X</button>

    <!-- Labeled search input and landmark -->
    <section aria-label="Site search">
      <label for="search-input">Search:</label>
      <input type="search" id="search-input" name="q">
    </section>
  </main>

</body>
</html>